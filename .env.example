# ==========================================
# DropPilot AI - Environment Variables
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development
SERVER_URL=http://localhost:5000

# Client Configuration (CORS & Redirects)
CLIENT_URL=http://localhost:5173

# Database Integration
MONGODB_URI=mongodb://localhost:27017/droppilot

# Authentication
JWT_SECRET=your_jwt_secret_key_placeholder

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_placeholder

# Shopify Store Integration (Admin API / OAuth)
SHOPIFY_CLIENT_ID=your_shopify_client_id_placeholder
SHOPIFY_CLIENT_SECRET=your_shopify_client_secret_placeholder
SHOPIFY_SCOPES=read_products,write_products
SHOPIFY_REDIRECT_URI=http://localhost:5000/api/shopify/callback

